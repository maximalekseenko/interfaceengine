@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(SDL3 REQUIRED)
find_dependency(SDL3_image REQUIRED)
find_dependency(SDL3_ttf REQUIRED)
find_dependency(necroutils REQUIRED)

if (NOT TARGET interfaceengine::interfaceengine)
  include(${CMAKE_CURRENT_LIST_DIR}/@targets_export_name@.cmake)
endif ()

check_required_components(interfaceengine)
